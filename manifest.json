{
  "manifest_version": 3,
  "name": "玥玥刷客",
  "version": "3.8.2",
  "description": "带可拖动网页浮窗、实时任务状态和第三方 AI 答题能力的网课学习助手。",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "webNavigation"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "显示或隐藏玥玥刷客",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "*://*.chaoxing.com/*",
        "*://*.xuexitong.com/*",
        "*://*.zhihuishu.com/*",
        "*://*.changjietong.com/*",
        "*://*.yuketang.cn/*",
        "*://*.rainclassroom.com/*",
        "*://*.icve.com.cn/*",
        "*://*.icourse163.org/*",
        "*://*.icourse163.cn/*",
        "*://*.xuexi.cn/*",
        "*://*.gxt.hnvcp.com/*",
        "*://*.nodedu.cn/*",
        "*://*.sflep.com/*",
        "*://*.cnki.net/*",
        "*://*.mosoteach.cn/*",
        "*://*.mtcsun.com/*",
        "*://*.xuanyaedu.com/*",
        "*://*.classin.cn/*",
        "*://*.eelive.cn/*",
        "*://*.edu.cn/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "*://*.chaoxing.com/*",
        "*://*.edu.cn/*"
      ],
      "resources": [
        "data/glyph-fingerprints-noto-sans-sc.json"
      ]
    }
  ]
}
